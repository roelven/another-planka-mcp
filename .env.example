# Planka MCP Server Configuration

# Required: Your Planka instance URL
PLANKA_BASE_URL=https://planka.example.com

# Authentication (choose one method)

# Option 1: Access Token (recommended)
# Generate via: curl -X POST https://your-planka.com/api/access-tokens \
#   -H "Content-Type: application/json" \
#   -d '{"emailOrUsername": "your-email", "password": "your-password"}'
# See README.md "Obtaining API Credentials" section for details
PLANKA_API_TOKEN=your-access-token-here

# Remote access settings (only needed for streamable-http transport)
# Transport mode: "stdio" for local/Claude Desktop, "streamable-http" for remote/Claude.ai
MCP_TRANSPORT=stdio

# MCP Server URL (required for streamable-http, must match your public URL)
# MCP_SERVER_URL=https://planka-mcp.yourdomain.com

# OAuth client credentials (required for streamable-http transport)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(16)); print(secrets.token_urlsafe(32))"
# Enter these same values in the Claude.ai MCP connector settings
# MCP_CLIENT_ID=your-client-id
# MCP_CLIENT_SECRET=your-client-secret

# Option 2: API Key (NOT YET AVAILABLE - feature under development)
# See: https://github.com/plankanban/planka/issues/945
# PLANKA_API_KEY=your-api-key-here

# Option 3: Email/Password (fallback, less secure)
# The server will authenticate automatically at startup
# PLANKA_EMAIL=your-email@example.com
# PLANKA_PASSWORD=your-password
